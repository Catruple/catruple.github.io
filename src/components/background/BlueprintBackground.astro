---
/** Fondo de cuadrícula de plano, sin bocetos decorativos. */
---

<div class="bg" aria-hidden="true">
    <div class="plane" data-blueprint-plane></div>
</div>

<script>
    const plane = document.querySelector<HTMLElement>('[data-blueprint-plane]');
    const motionPreference = matchMedia('(prefers-reduced-motion: reduce)');
    let queued = false;

    const paint = () => {
        queued = false;
        // Move only the infinitely repeating texture. The surface stays in
        // place, with no wrapping of the offset or interpolated reset.
        plane?.style.setProperty('--grid-offset', `${motionPreference.matches ? 0 : -window.scrollY * .4}px`);
    };
    const requestPaint = () => {
        if (queued) return;
        queued = true;
        requestAnimationFrame(paint);
    };
    addEventListener('scroll', requestPaint, { passive: true });
    motionPreference.addEventListener('change', requestPaint);
    paint();
</script>

<style>
    .bg {
        position: fixed; inset: 0; z-index: 0; overflow: hidden; pointer-events: none;
        perspective: 1100px; perspective-origin: 50% 35%;
        background: var(--bg); transition: background-color .3s;
    }
    /* desvanece la lejanía y oscurece un poco las orillas */
    .bg::after {
        content: ""; position: absolute; inset: 0;
        background:
            linear-gradient(to bottom, var(--bg) 0%, transparent 38%),
            radial-gradient(ellipse at 50% 55%, transparent 55%, rgb(0 0 0 / .16) 100%);
    }
    .plane {
        position: absolute; left: 50%; top: 50%;
        width: 7000px; height: 5200px; margin: -2600px 0 0 -3500px;
        transform:
            rotateX(56deg)
            rotateZ(-24deg)
            translateY(280px);
        background-image:
            linear-gradient(rgb(var(--fg-rgb) / .2) 3px, transparent 3px),
            linear-gradient(90deg, rgb(var(--fg-rgb) / .2) 3px, transparent 3px),
            linear-gradient(rgb(var(--fg-rgb) / .07) 2px, transparent 2px),
            linear-gradient(90deg, rgb(var(--fg-rgb) / .07) 2px, transparent 2px);
        background-repeat: repeat;
        background-position: 0 var(--grid-offset, 0px);
        background-size: 300px 300px, 300px 300px, 30px 30px, 30px 30px;
    }
    @media (max-width: 700px) {
        .plane { opacity: .85; }
    }
</style>
