---
/** Ventana dibujada a trazo. Si no está `done`, le falta el borde de abajo. */
import { place, type Box } from '@/lib/placement';

interface Props {
  title: string;
  box: Box;
  done?: boolean;
}

const { title, box, done = false } = Astro.props;
---

<div class:list={['sketch-win', { done }]} style={place(box)}>
    <div class="tb"><i class="cb"></i><b>{title}</b></div>
    <slot />
</div>

<style>
    .sketch-win { border: 6px solid currentColor; border-bottom-style: dashed; }
    .done { border-bottom-style: solid; }

    .tb {
        position: relative; height: 56px; display: flex; align-items: center; justify-content: center;
        border-bottom: 6px solid currentColor;
        background: repeating-linear-gradient(to bottom, currentColor 0 4px, transparent 4px 10px);
    }
    .tb b { padding: 0 26px; background: var(--bg); font-size: 28px; letter-spacing: .08em; text-transform: uppercase; }
    .cb { position: absolute; left: 14px; top: 9px; width: 30px; height: 30px; border: 5px solid currentColor; background: var(--bg); }
</style>
