---
/** Ventana "Avance.exe" con barra de progreso animada. */
import Window from '@/components/ui/Window.astro';

interface Props {
  label: string;
  percent: number;
  remark: string;
}

const { label, percent, remark } = Astro.props;
---

<Window title="Avance.exe">
    <div class="body">
        <p>{label}</p>
        <div class="bar" role="progressbar" aria-valuenow={percent} aria-valuemin="0" aria-valuemax="100" aria-label={label}>
            <i style={`width:${percent}%`}></i>
        </div>
        <div class="meta"><span>{percent}%</span><span>{remark}</span></div>
    </div>
</Window>

<style>
    .body { padding: 1rem 1.1rem 1.1rem; }
    p { margin: 0 0 .7rem; font-weight: 600; }
    .bar { height: 26px; padding: 3px; background: var(--paper); border: 3px solid var(--ink); }
    .bar i {
        display: block; height: 100%;
        background-color: var(--paper);
        background-image: linear-gradient(45deg, var(--ink) 25%, transparent 25%, transparent 50%, var(--ink) 50%, var(--ink) 75%, transparent 75%);
        background-size: 16px 16px;
        animation: barber .6s linear infinite;
    }
    .meta { display: flex; justify-content: space-between; margin-top: .6rem; font-family: var(--silk); font-size: .66rem; letter-spacing: .08em; text-transform: uppercase; }

    @keyframes barber { to { background-position: 16px 0; } }
</style>
