---
/** Pie de página: pendientes, avance y cajetín. */
import Container from '@/components/ui/Container.astro';
import TodoNote from './TodoNote.astro';
import ProgressWindow from './ProgressWindow.astro';
import TitleBlock from './TitleBlock.astro';
import { BUILD_PROGRESS, TITLE_BLOCK, TODOS } from '@/data/footer';
---

<Container as="footer" class="footer">
    <TodoNote title="Pendientes:" items={TODOS} />
    <ProgressWindow {...BUILD_PROGRESS} />
    <TitleBlock {...TITLE_BLOCK} />
</Container>

<style>
    .footer {
        position: relative; z-index: 1; margin-top: 4rem; padding-block: 2rem 4rem;
        display: grid; grid-template-columns: 1fr 1fr 1.1fr; gap: 2.6rem; align-items: start;
    }

    @media (max-width: 980px) {
        .footer { grid-template-columns: 1fr; }
    }
    @media (max-width: 700px) {
        .footer { padding-bottom: 3rem; }
    }
</style>
