---
/** Pie de página: pendientes, avance y cajetín. */
import Container from '@/components/ui/Container.astro';
import FooterInfo from './FooterInfo.astro';
import CommunityWindow from './CommunityWindow.astro';
import TitleBlock from './TitleBlock.astro';
---

<Container as="footer" class="footer">
    <CommunityWindow />
    <TitleBlock />
    <FooterInfo />
</Container>

<style>
    .footer {
        position: relative; z-index: 1; margin-top: 4rem; padding-block: 2rem 4rem;
        display: grid; grid-template-columns: 1.2fr 1fr; gap: 2.6rem; align-items: start;
    }

    @media (max-width: 980px) {
        .footer { grid-template-columns: 1fr; }
    }
    @media (max-width: 700px) {
        .footer { padding-bottom: 3rem; }
    }
@media (max-width: 700px) { .footer { margin-top: 2rem; gap: 2rem; } }
</style>
