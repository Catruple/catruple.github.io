---
import PixelIcon from '@/components/ui/PixelIcon.astro';
import { PROJECT_LIST } from '@/data/projects';
const total = PROJECT_LIST.length;
const categories = new Set(PROJECT_LIST.map(project => project.category)).size;
---
<aside class="passport" aria-label="Ficha de Catruple">
    <div class="heading"><span>CATRUPLE / INFO.SYS</span><span aria-hidden="true">✦</span></div>
    <div class="identity">
        <span class="cat"><PixelIcon name="cat" size={36} /></span>
        <div><h3>Software sin peajes.</h3><p>Seleccionado por Odruu.</p></div>
    </div>
    <div class="stats">
        <div><strong>{total}</strong><span>Herramientas</span></div>
        <div><strong>{categories}</strong><span>Categorías</span></div>
        <div><strong>0</strong><span>Suscripciones</span></div>
    </div>
    <div class="bottom">
        <span class="seal">HECHO PARA COMPARTIR</span>
        <a href="https://github.com/Odruu/Catruple" target="_blank" rel="noopener noreferrer">Explorar el código ↗</a>
    </div>
</aside>
<style>
 .passport { background: var(--paper); color: var(--ink); border: 3px solid var(--ink); box-shadow: 6px 6px 0 var(--ink); transform: rotate(.7deg); }
 .heading { display: flex; justify-content: space-between; align-items: center; padding: .5rem .75rem; border-bottom: 3px solid var(--ink); font: .6rem/1.4 var(--silk); letter-spacing: .06em; background: var(--ink); color: var(--paper); }
 .heading > span:last-child { color: var(--acc); font-size: 1rem; }
 .identity { display: flex; align-items: center; gap: .8rem; padding: 1rem; }
 .cat { display: grid; place-items: center; flex: none; width: 54px; height: 54px; background: var(--acc); color: #0b0b14; border: 2px solid var(--ink); box-shadow: 3px 3px 0 var(--ink); }
 h3 { font: 400 1.8rem/1 var(--tool-title); margin: 0 0 .35rem; }
 p { font: 1.05rem/1.3 var(--description); margin: 0; }
 .stats { display: grid; grid-template-columns: repeat(3,minmax(0,1fr)); margin: 0 1rem; border: 2px solid var(--ink); }
 .stats div { display: flex; flex-direction: column; align-items: center; padding: .6rem .15rem; }
 .stats div + div { border-left: 2px solid var(--ink); }
 strong { font: 400 2rem/1 var(--tool-title); }
 .stats span { font: .95rem/1.4 var(--description); }
 .bottom { padding: 1rem; display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: .8rem; }
 .seal { border: 2px dashed currentColor; padding: .35rem; font: .5rem/1.4 var(--silk); transform: rotate(-3deg); }
 a { color: inherit; font: 1.1rem/1.3 var(--tool-title); text-underline-offset: 4px; }
 a:hover { background: var(--acc); color: #0b0b14; }
 @media(max-width:700px) { .passport { transform: none; } a { display: flex; align-items: center; min-height: 44px; } }
</style>
