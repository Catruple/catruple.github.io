---
/** Logo del sitio. */
import PixelIcon from '@/components/ui/PixelIcon.astro';
import { withBase } from '@/lib/paths';
---

<a class="brand" href={withBase()}>
    <PixelIcon name="cat" size={30} />
    <span>CATRUPLE<i>.COM</i></span>
</a>

<style>
    .brand {
        display: flex; align-items: center; gap: .6rem; padding: .15rem .3rem;
        font-family: var(--silk); font-weight: 700; font-size: 1rem; letter-spacing: .04em;
        color: var(--ink); text-decoration: none;
    }
    .brand i { font-style: normal; background: var(--ink); color: var(--paper); padding: 0 .3rem; margin-left: .15rem; }
@media (max-width: 700px) { .brand { font-size: .8rem; gap: .35rem; padding-inline: 0; } }
@media (max-width: 359px) { .brand { font-size: .7rem; } }
</style>
