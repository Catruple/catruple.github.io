---
import Button from '@/components/ui/Button.astro';
---
<Button size="sm" class="mode-button" data-dark-mode aria-pressed="false" aria-label="Activar modo oscuro" title="Activar modo oscuro">
    <svg class="moon" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M10 2H6v2H4v2H2v10h2v4h4v2h10v-2h2v-4h-6v-2h-4v-4H8V6h2z" /></svg>
    <svg class="sun" width="22" height="22" viewBox="0 0 24 24" fill="currentColor" shape-rendering="crispEdges" aria-hidden="true"><path d="M10 0h4v4h-4zM10 20h4v4h-4zM0 10h4v4H0zM20 10h4v4h-4zM3 3h3v3H3zM18 3h3v3h-3zM3 18h3v3H3zM18 18h3v3h-3zM8 6h8v2h2v8h-2v2H8v-2H6V8h2z" /></svg>
</Button>
<style>
    .sun { display: none; }
    :global(html[data-mode="dark"]) .sun { display: block; }
    :global(html[data-mode="dark"]) .moon { display: none; }
</style>
<script>
    const button = document.querySelector<HTMLButtonElement>('[data-dark-mode]');
    const sync = () => {
        const dark = document.documentElement.dataset.mode === 'dark';
        button?.setAttribute('aria-pressed', String(dark));
        const label = dark ? 'Activar modo claro' : 'Activar modo oscuro';
        button?.setAttribute('aria-label', label);
        button?.setAttribute('title', label);
    };
    button?.addEventListener('click', () => {
        const mode = document.documentElement.dataset.mode === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.mode = mode;
        try { localStorage.setItem('catruple-mode', mode); } catch {}
        sync();
    });
    sync();
</script>
