---
/** Menú principal: cada enlace filtra el repositorio por categoría. */
import { NAV_ITEMS } from '@/data/categories';
import { SECTION_IDS } from '@/config/site';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<nav class:list={['menu', className]} aria-label="Principal">
    {NAV_ITEMS.map((item) => <a href={`#${SECTION_IDS.catalog}`} data-nav-filter={item.filter}>{item.label}</a>)}
</nav>

<script>
    import { setFilter, subscribe } from '@/scripts/catalog-store';
    import type { CategoryId } from '@/data/categories';

    const links = [...document.querySelectorAll<HTMLAnchorElement>('[data-nav-filter]')];

    links.forEach((a) =>
        a.addEventListener('click', () => setFilter(a.dataset.navFilter as CategoryId, true)),
    );

    subscribe(({ filter, fromNav }) => {
        links.forEach((a) => {
            if (fromNav && a.dataset.navFilter === filter) a.setAttribute('aria-current', 'true');
            else a.removeAttribute('aria-current');
        });
    });
</script>

<style>
    .menu { display: flex; gap: .2rem; }
    .menu a {
        padding: .2rem .65rem;
        font-family: var(--tool-title); font-weight: 400; font-size: 1.1rem; letter-spacing: .05em;
        color: var(--ink); text-decoration: none; text-transform: uppercase;
    }
    .menu a:hover, .menu a[aria-current] { background: var(--ink); color: var(--paper); }
@media (max-width: 700px) {
 .menu { justify-content: space-between; gap: 0; }
 .menu a { display: flex; align-items: center; justify-content: center; min-height: 44px; padding: .3rem .3rem; font-size: 1rem; letter-spacing: 0; white-space: nowrap; }
}
</style>
