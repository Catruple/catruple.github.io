---
/** Barra de menú fija estilo Mac: compone las piezas del encabezado. */
import Brand from './Brand.astro';
import MainNav from './MainNav.astro';
import SearchBox from './SearchBox.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';
import DarkMode from './DarkMode.astro';
import Clock from './Clock.astro';
---

<header class="menubar">
    <Brand />
    <MainNav class="nav" />
    <span class="spacer"></span>
    <SearchBox class="search-slot" />
    <LanguageSwitcher />
    <DarkMode />
    <Clock class="desktop-only" />
</header>

<style>
    .menubar {
        position: sticky; top: 0; z-index: 100;
        display: flex; align-items: center; gap: .7rem;
        padding: .25rem 1.2rem .25rem 1.4rem;
        background: var(--paper); color: var(--ink);
        border-bottom: 3px solid var(--ink);
        box-shadow: 0 5px 0 rgb(0 0 0 / .28);
    }
    .menubar :global([data-language-toggle]),
    .menubar :global([data-dark-mode]) {
        width: 34px; height: 34px; min-width: 34px; font-size: 1.1rem;
        padding: 0; justify-content: center; align-items: center;
    }

    /* Ninguna pieza se aplasta; solo el buscador cede algo de ancho. */
    .menubar > :global(*) { flex-shrink: 0; }
    .menubar > .search-slot { flex: 0 1 230px; min-width: 150px; }
    .spacer { flex: 1; }

    /* Si no cabe todo en una fila, el menú baja a una segunda fila. */
    @media (max-width: 1280px) {
        .menubar { flex-wrap: wrap; gap: .4rem .8rem; }
        .nav { order: 5; width: 100%; overflow-x: auto; }
    }
    @media (max-width: 860px) {
        .menubar .desktop-only { display: none; }
    }
@media (max-width: 700px) {
 .menubar { padding: .45rem .75rem .2rem; gap: .35rem .5rem; }
 .menubar :global([data-language-toggle]), .menubar :global([data-dark-mode]) { width: 44px; height: 44px; min-width: 44px; }
 .nav { min-width: 0; }
 .menubar > .search-slot { order: 6; flex: 1 0 100%; width: 100%; min-width: 0; margin-bottom: .35rem; }
}
</style>
