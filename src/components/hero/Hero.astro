---
/** Portada: titular, llamado a la acción y panel de control. */
import Container from '@/components/ui/Container.astro';
import Button from '@/components/ui/Button.astro';
import Annotation from '@/components/ui/Annotation.astro';
import ControlPanel from './ControlPanel.astro';
import { SITE, SECTION_IDS } from '@/config/site';
---

<Container as="section" class="hero">
    <div>
        <span class="sheet-tag">PLANO Nº 001 · REV 0.4 · BORRADOR</span>
        <h1>
            Infraestructura <span class="hl">y herramientas</span> sin <span class="scr"
                >rodeos.<svg viewBox="0 0 200 14" preserveAspectRatio="none" aria-hidden="true"
                    ><path vector-effect="non-scaling-stroke" d="M2 9 C 30 2, 60 13, 100 7 S 170 3, 198 8"></path></svg
                ></span
            >
        </h1>
        <div class="dim"><span>SIN RELLENO · SIN PLANTILLAS · SIN PERMISO</span></div>
        <p class="lead">{SITE.description}</p>

        <div class="actions">
            <Button href={`#${SECTION_IDS.catalog}`} variant="primary">Explorar utilidades</Button>
            <Button href={SITE.github} target="_blank" rel="noopener">GitHub oficial</Button>
            <Annotation class="start-here" flip tilt={-4}>empieza por acá</Annotation>
        </div>
    </div>

    <ControlPanel />
</Container>

<style>
    .hero {
        display: grid; grid-template-columns: 1.12fr 1fr; gap: 3.5rem; align-items: center;
        padding-top: 4rem; padding-bottom: 2rem;
    }

    .sheet-tag {
        display: inline-flex; align-items: center; gap: .6rem; margin-bottom: 1.4rem; padding: .3rem .7rem;
        font-family: var(--silk); font-size: .72rem; letter-spacing: .08em;
        color: rgb(var(--fg-rgb) / .85); border: 2px dashed rgb(var(--fg-rgb) / .7);
    }
    .sheet-tag::before {
        content: ""; width: 9px; height: 9px;
        background: var(--acc); border: 1px solid var(--ink);
        animation: blink 1.2s steps(2) infinite;
    }

    h1 {
        margin: 0 0 1rem; text-transform: uppercase; overflow-wrap: break-word;
        font-family: var(--px); font-weight: 700; line-height: 1.02; letter-spacing: -.01em;
        font-size: clamp(2rem, 4.4vw, 3.9rem);
        color: rgb(var(--fg-rgb)); text-shadow: 4px 4px 0 var(--sh);
    }
    .hl {
        display: inline-block; padding: 0 .2em;
        color: var(--ink); text-shadow: none; background: var(--acc);
        border: 3px solid var(--ink); box-shadow: 4px 4px 0 var(--ink);
        transform: rotate(-1.5deg);
    }
    .scr { position: relative; display: inline-block; }
    .scr svg {
        position: absolute; left: -2%; bottom: -.2em; width: 104%; height: .3em; overflow: visible;
        fill: none; stroke: var(--note); stroke-width: 5; stroke-linecap: round;
    }

    .dim {
        display: flex; align-items: center; gap: .6rem; margin-bottom: 1.2rem;
        font-family: var(--silk); font-size: .68rem; letter-spacing: .08em; color: rgb(var(--fg-rgb) / .85);
    }
    .dim::before, .dim::after { content: ""; flex: 1; height: 14px; background: linear-gradient(currentColor, currentColor) 0 50% / 100% 1px no-repeat; }
    .dim::before { border-left: 1px solid currentColor; }
    .dim::after { border-right: 1px solid currentColor; }

    .lead { margin: 0 0 1.8rem; max-width: 34rem; font-size: 1.15rem; color: rgb(var(--fg-rgb) / .92); }
    .actions { display: flex; flex-wrap: wrap; align-items: flex-end; gap: 1rem; }
    .start-here { margin-left: .4rem; }

    @media (max-width: 980px) {
        .hero { grid-template-columns: 1fr; gap: 4rem; padding-top: 2.5rem; }
    }
</style>
