---
/** Fila del panel: al pulsarla, limpia los filtros y resalta la tarjeta del proyecto. */
import PixelIcon from '@/components/ui/PixelIcon.astro';
import { cardDomId } from '@/data/projects';
import type { PanelRow } from '@/data/panel';

interface Props {
  row: PanelRow;
}

const { row } = Astro.props;
const target = cardDomId(row.project);
---

<a class="row" href={`#${target}`} data-panel-row={target}>
    <PixelIcon name={row.icon} size={36} />
    <span class="txt">
        <span class="t">{row.title}</span>
        <span class="d">{row.description}</span>
    </span>
    <span class="m">{row.meta}</span>
</a>

<script>
    import { resetCatalog } from '@/scripts/catalog-store';
    import { highlightCard } from '@/scripts/highlight-card';

    document.querySelectorAll<HTMLAnchorElement>('[data-panel-row]').forEach((row) =>
        row.addEventListener('click', (e) => {
            e.preventDefault();
            resetCatalog();
            highlightCard(row.dataset.panelRow!);
        }),
    );
</script>

<style>
    .row {
        display: flex; align-items: center; gap: .75rem; padding: .5rem .7rem; min-width: 0;
        background: #fff; color: var(--ink); text-decoration: none; border: 2px solid var(--ink);
    }
    .row:hover { background: var(--ink); color: var(--paper); }
    .txt { display: block; min-width: 0; }
    .t, .d { display: block; }
    .t { font-family: var(--tool-title); font-weight: 400; font-size: 1.4rem; line-height: 1.1; }
    .d { display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; overflow: hidden; font-family: var(--description); font-weight: 400; font-size: 1.05rem; opacity: 1; line-height: 1.3; letter-spacing: .015em; margin-top: .2rem; }
    .m {
        margin-left: auto; padding: .15rem .4rem; white-space: nowrap; flex-shrink: 0;
        font-family: var(--silk); font-size: .55rem; letter-spacing: .04em; border: 2px solid currentColor;
    }

    @media (max-width: 700px) {
        .d { display: none; }
    }
@media (max-width: 700px) {
 .row { display: grid; grid-template-columns: 32px minmax(0, 1fr); gap: .2rem .65rem; }
 .row :global(svg) { width: 32px; height: 32px; grid-row: 1 / 3; }
 .t { font-size: 1.25rem; }
 .m { grid-column: 2; margin-left: 0; width: fit-content; max-width: 100%; font-size: .5rem; }
}
</style>
