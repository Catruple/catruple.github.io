---
/** Fila del panel: al pulsarla, limpia los filtros y resalta la tarjeta del proyecto. */
import PixelIcon from '@/components/ui/PixelIcon.astro';
import { cardDomId } from '@/data/projects';
import type { PanelRow } from '@/data/panel';

interface Props {
  row: PanelRow;
}

const { row } = Astro.props;
const target = cardDomId(row.project);
---

<a class="row" href={`#${target}`} data-panel-row={target}>
    <PixelIcon name={row.icon} size={36} />
    <span class="txt">
        <span class="t">{row.title}</span>
        <span class="d">{row.description}</span>
    </span>
    <span class="m">{row.meta}</span>
</a>

<script>
    import { resetCatalog } from '@/scripts/catalog-store';
    import { highlightCard } from '@/scripts/highlight-card';

    document.querySelectorAll<HTMLAnchorElement>('[data-panel-row]').forEach((row) =>
        row.addEventListener('click', (e) => {
            e.preventDefault();
            resetCatalog();
            highlightCard(row.dataset.panelRow!);
        }),
    );
</script>

<style>
    .row {
        display: flex; align-items: center; gap: .9rem; padding: .65rem .8rem;
        background: #fff; color: var(--ink); text-decoration: none; border: 2px solid var(--ink);
    }
    .row:hover { background: var(--ink); color: var(--paper); }
    .txt { display: block; min-width: 0; }
    .t, .d { display: block; }
    .t { font-weight: 700; font-size: 1rem; }
    .d { font-size: .88rem; opacity: .8; line-height: 1.3; }
    .m {
        margin-left: auto; padding: .15rem .4rem; white-space: nowrap;
        font-family: var(--silk); font-size: .6rem; letter-spacing: .04em; border: 2px solid currentColor;
    }

    @media (max-width: 700px) {
        .d { display: none; }
    }
</style>
