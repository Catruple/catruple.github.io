---
/** Contenedor centrado con los márgenes laterales del sitio. */
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'div'> & {
  as?: 'div' | 'section' | 'footer' | 'header';
};

const { as: Tag = 'div', class: className, ...attrs } = Astro.props;
---

<Tag class:list={['wrap', className]} {...attrs}>
    <slot />
</Tag>

<style>
    .wrap { max-width: var(--container); margin-inline: auto; padding-inline: var(--gutter-l) var(--gutter-r); }
</style>
