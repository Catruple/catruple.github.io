---
/** Documento HTML: <head>, fuentes, estilos globales y tema guardado. */
import '@/styles/global.css';
import '@/styles/fonts.css';
import { SITE, THEME_STORAGE_KEY, CLOUDFLARE_ANALYTICS_TOKEN } from '@/config/site';
import { DEFAULT_THEME } from '@/data/themes';
import { themeCss } from '@/lib/theme-css';
import { withBase } from '@/lib/paths';

interface Props {
  title?: string;
  description?: string;
  /** Imagen de vista previa al compartir el enlace (ruta dentro de public/). */
  image?: string;
  imageAlt?: string;
  /** true en páginas que no deben aparecer en buscadores (p. ej. la 404). */
  noindex?: boolean;
}

const {
  title = SITE.title,
  description = SITE.description,
  image = 'og-image.png',
  imageAlt = 'Catruple: deja de pagar, software gratis. Catálogo de herramientas gratis y de código abierto.',
  noindex = false,
} = Astro.props;

// Las redes sociales necesitan URLs absolutas.
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(withBase(image), Astro.site).href;

// Analítica sin cookies; solo en la web publicada para no contar visitas locales.
const analyticsToken = import.meta.env.PROD ? CLOUDFLARE_ANALYTICS_TOKEN : '';
---

<!doctype html>
<html lang={SITE.lang} data-theme={DEFAULT_THEME.id} data-mode="light">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <meta name="description" content={description} />
        <meta name="generator" content={Astro.generator} />
        <link rel="icon" href={withBase('favicon.ico')} sizes="16x16 32x32 48x48" />
        <link rel="apple-touch-icon" href={withBase('apple-touch-icon.png')} />
        {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={pageUrl} />}
        <title>{title}</title>

        <!-- Vista previa al compartir el enlace (Discord, WhatsApp, X, Telegram…). -->
        <!-- Discord usa theme-color para la franja lateral del embed. -->
        <meta name="theme-color" content={DEFAULT_THEME.bg} />
        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={SITE.name} />
        <meta property="og:locale" content={SITE.locale.replace('-', '_')} />
        <meta property="og:url" content={pageUrl} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:image" content={imageUrl} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={imageAlt} />
        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content={imageUrl} />
        <meta name="twitter:image:alt" content={imageAlt} />

        <!-- Aplica el modo guardado antes de pintar, para evitar un parpadeo. -->
        <script is:inline define:vars={{ storageKey: THEME_STORAGE_KEY }}>
            try {
                var mode = localStorage.getItem('catruple-mode');
                // Claro por defecto; solo se usa oscuro si el visitante lo eligió.
                document.documentElement.dataset.mode = mode === 'dark' ? 'dark' : 'light';
                // El color de Pantalla siempre arranca en azul; se borra el que
                // guardaban versiones anteriores para que no se quede pegado.
                localStorage.removeItem(storageKey);
            } catch (e) {}
        </script>
        <Fragment set:html={`<style>${themeCss()}</style>`} />

        {analyticsToken && (
            <script
                is:inline
                type="module"
                src="https://static.cloudflareinsights.com/beacon.min.js"
                data-cf-beacon={JSON.stringify({ token: analyticsToken })}
            ></script>
        )}
    </head>
    <body>
        <slot />
    </body>
</html>
