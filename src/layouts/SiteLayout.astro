---
/** Estructura común de las páginas: fondo, barra de menú, pie y diálogo. */
import BaseLayout from './BaseLayout.astro';
import DoodleSprite from '@/components/ui/DoodleSprite.astro';
import AlertDialog from '@/components/ui/AlertDialog.astro';
import BlueprintBackground from '@/components/background/BlueprintBackground.astro';
import MenuBar from '@/components/header/MenuBar.astro';
import SiteFooter from '@/components/footer/SiteFooter.astro';

type Props = {
  title?: string;
  description?: string;
};

const props = Astro.props;
---

<BaseLayout {...props}>
    <DoodleSprite />
    <BlueprintBackground />
    <a class="skip-link" href="#main-content">Saltar al contenido</a>
    <MenuBar />
    <main id="main-content" tabindex="-1">
        <slot />
    </main>
    <SiteFooter />
    <AlertDialog />
</BaseLayout>

<style>
    main { position: relative; z-index: 1; }
</style>
